{
  "name": "@quran-corpus/data",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./mobile": {
      "import": "./dist/mobile.js",
      "types": "./dist/mobile.d.ts"
    },
    "./user-db": {
      "import": "./dist/userData.js",
      "types": "./dist/userData.d.ts"
    }
  },
  "scripts": {
    "generate:schema": "node scripts/generate-schema.mjs",
    "build": "node scripts/generate-schema.mjs && tsc",
    "type-check": "node scripts/generate-schema.mjs && tsc --noEmit",
    "pretest": "node scripts/generate-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0"
  },
  "devDependencies": {
    "@quran-corpus/config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
