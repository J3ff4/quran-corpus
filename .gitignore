# Dependencies
# No trailing slash: `node_modules/` matches directories only, so three
# self-referencing symlinks named node_modules slipped past it and were
# committed. Anyone cloning got a symlink loop where their install should be
# (`pnpm -r type-check` died with ELOOP), because git restores the link and
# pnpm then writes through it.
node_modules
.pnpm-store/

# Build outputs
.next/
dist/
out/
coverage/
.expo/

# Expo / React Native. `expo prebuild` regenerates android/ and ios/ from
# app.json, so the native projects are build output, not source. The signing
# material below must never reach git — EAS holds the release keystore.
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Serwist-generated service worker (build artifact, not source)
apps/web/public/sw.js
apps/web/public/sw.js.map

# Database files — data artifacts stay out of git
*.db

# Raw scraped/imported data snapshots — re-fetch, never commit (CLAUDE.md §11)
data-snapshots/
.snapshots/
packages/scraper/checkpoint.json
*.db-shm
*.db-wal
raw-scrape/
checkpoint.json
*checkpoint*.json
*.stale.bak

# Impeccable copy-edit tool scratch fixtures
.impeccable/

# Environment
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store
Thumbs.db

# Turbo
.turbo/

# Editor
.vscode/settings.json
.idea/

# Screenshot / scratch reference (not source)
temp/
.worktrees/

# SDD workspace scratch (subagent-driven-development)
.superpowers/

# /browse (gstack) audit scratch
.gstack/

# Local data artifacts — DB, backups, logs, checkpoints, snapshots (CLAUDE.md §9/§11)
quran-data/

# Duplicate local copies of the repo (nested clone + zip download) — never version them
quran-corpus-pwa/
quran-corpus-pwa-main.zip

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
