{
  "name": "quran-corpus-pwa",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@quran-corpus/config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0"
  }
}
