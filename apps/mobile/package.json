{
  "name": "@quran-corpus/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "eas-build-post-install": "cd ../.. && pnpm --filter @quran-corpus/data build && pnpm --filter @quran-corpus/mobile-data build",
    "prebuild:assert-db": "test -f assets/db/quran.db || { echo 'Missing apps/mobile/assets/db/quran.db. The corpus DB is generated, not committed -- run: pnpm generate:m1-db' >&2; exit 1; }",
    "build": "pnpm prebuild:assert-db && expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@quran-corpus/config": "workspace:*",
    "@quran-corpus/data": "workspace:*",
    "@quran-corpus/mobile-data": "workspace:*",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^9.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
