{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"]
  },
  // src/ only, matching vitest.config.ts. app/ must not hold test files at all
  // (expo-router bundles everything under it as a route), so there is nothing
  // there for this glob to miss. Route tests sit in src/test/routes/.
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "exclude": []
}
