{
  "expo": {
    "name": "Quran Corpus",
    "slug": "quran-corpus-mobile",
    "scheme": "qurancorpus",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icons/icon.png",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "android": {
      "package": "com.qurancorpus.mobile",
      "minSdkVersion": 26,
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#faf8f3"
      },
      "permissions": []
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f3",
          "dark": {
            "backgroundColor": "#151412"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "audioApiBaseUrl": "",
      "sentryDsn": "",
      "posthogKey": "",
      "posthogHost": ""
    }
  }
}
